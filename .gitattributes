# Normalise text on the way in, check out native on Windows.
* text=auto

# Must stay LF or they will not run.
gradlew text eol=lf
*.sh text eol=lf

# Must stay CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# The original game, byte for byte. Never touch these.
*.apk binary
*.zip binary
*.so binary
*.jar binary
payload/data.vfs.mp3 binary
*.png binary
