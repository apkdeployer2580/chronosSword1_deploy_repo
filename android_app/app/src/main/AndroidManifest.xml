<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The original manifest asked for INTERNET, WIFI/NETWORK state, VIBRATE,
      WAKE_LOCK and the two package-killing permissions.

      INTERNET is back: the original services are gone, but the guest's network code
      is intact and `net::redirect_target` points it at a private server, so the
      online features (편지, 상점, the cash/charge path) work again. Without it
      `connect` fails with EPERM before it leaves the process — which is exactly
      how this was found. INTERNET is install-time, so there is still no runtime
      permission prompt.

      The rest stay out: network *state* is answered by the runtime itself, and
      vibration is not wired up yet (VIBRATE comes back when it is).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme">

            <!-- GameActivity loads the native library named here (libmain.so). -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
